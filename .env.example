# Lucen — environment variables
# Copy to .env.local and fill in. With NONE of these set, Lucen runs in "seed
# mode": the whole library is browsable from built-in demo content, but auth,
# billing and real downloads are disabled. Add the blocks below to go live.

# ---- Site -------------------------------------------------------------------
# Public base URL (no trailing slash). Used for OG tags, auth + Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (auth, database, storage) -------------------------------------
# Project URL + anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Never expose. Reads item_secrets, mints
# signed URLs, writes subscriptions from the webhook, powers the admin.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket names (defaults shown; match your migration).
SUPABASE_ASSET_BUCKET=asset-bundles
SUPABASE_MEDIA_BUCKET=preview-media

# ---- Stripe (subscriptions) -------------------------------------------------
STRIPE_SECRET_KEY=
# From `stripe listen` (dev) or the dashboard webhook endpoint (prod).
STRIPE_WEBHOOK_SECRET=
# Price IDs for the two plans (create products in Stripe first).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# ---- Admin ------------------------------------------------------------------
# Comma-separated emails allowed into /admin.
ADMIN_EMAILS=you@example.com
