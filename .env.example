# Lucen — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Postgres + Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the client. Used by gating routes
# and the admin panel for item_secrets access.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (subscription billing) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from the Stripe dashboard (Pro Monthly + Pro Annual).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# --- Access control ---
# Comma-separated list of emails allowed into /admin.
ADMIN_EMAILS=
